# ========================================================
# LUMA PRESETS — Environment Variables
# ========================================================
# Salin ke .env.local untuk development, atau isi di Vercel Project > Settings > Environment Variables.

# URL publik aplikasi (dipakai untuk link download di WhatsApp & callback)
# Production contoh: https://luma-presets-store.vercel.app
# Di Vercel, jika kosong akan fallback ke VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
APP_URL=http://localhost:3000

# --------------------------------------------------------
# 1. DATABASE (NEON POSTGRESQL)
# --------------------------------------------------------
# Gunakan host "-pooler" untuk koneksi serverless/Vercel.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --------------------------------------------------------
# 2. MIDTRANS (PAYMENT GATEWAY)
# --------------------------------------------------------
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxx
MIDTRANS_IS_PRODUCTION=true
# Opsional: jika dashboard Midtrans menampilkan Payment Signature Secret Key terpisah.
# Kosongkan untuk memakai MIDTRANS_SERVER_KEY.
MIDTRANS_SIGNATURE_KEY=

# Wajib untuk Snap di browser (Next.js public env, tersedia saat build)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxx
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=true

# --------------------------------------------------------
# 3. FONNTE (WHATSAPP DELIVERY)
# --------------------------------------------------------
FONNTE_TOKEN=your_fonnte_token

# --------------------------------------------------------
# 4. GAMBAR TEMA (OPSIONAL)
# --------------------------------------------------------
# Kosongkan untuk memakai Openverse (tanpa key, lisensi CC0/PDM/BY).
# Isi salah satu untuk hasil lebih baik: Unsplash, Pexels, atau Pixabay.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --------------------------------------------------------
# 5. ADMIN
# --------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASS=change-me
# Secret untuk token sesi admin (disarankan random & panjang)
ADMIN_SESSION_SECRET=random-long-secret-string
