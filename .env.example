# ========================================================
# LUMA PRESETS — Configuration Environment Variables
# ========================================================

# URL Aplikasi (digunakan untuk link download WhatsApp & callback Midtrans)
# Contoh development: http://localhost:3001
# Contoh production: https://presets.luma.id
APP_URL=http://localhost:3001
PORT=3001

# --------------------------------------------------------
# 1. INTEGRASI MIDTRANS (AUTOMATIC PAYMENT GATEWAY)
# --------------------------------------------------------
# Dapatkan Server Key & Client Key dari Midtrans Dashboard > Settings > Access Keys
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxx
# Set 'true' jika Production, 'false' jika Sandbox
MIDTRANS_IS_PRODUCTION=true

# --------------------------------------------------------
# 2. INTEGRASI SUPABASE (DATABASE & STORAGE)
# --------------------------------------------------------
# Dapatkan Project URL & Service Role Key dari Supabase Dashboard > Project Settings > API
# Catatan: Jika dikosongkan, server otomatis memakai SQLite lokal (data/luma.db)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# --------------------------------------------------------
# 3. INTEGRASI FONNTE WHATSAPP (INSTANT DIGITAL DELIVERY)
# --------------------------------------------------------
# Dapatkan Device Token dari https://fonnte.com (device yang sudah connected / scan QR)
FONNTE_TOKEN=your_fonnte_token

# --------------------------------------------------------
# 4. KREDENSIAL PANEL ADMIN (Akses via [APP_URL]/#admin)
# --------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASS=admin123
